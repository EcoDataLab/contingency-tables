      "id": "component-cost",
      "title": "Encoded completion and schedule",
      "english_claim": "The encoded completion draw and numeric schedule realizers have polynomial charged cost; completion semantics identifies output code and accuracy under dense margin hypotheses.",
      "quantity": "Polynomial charged component cost",
      "hypotheses": [
        "Completion: d≥14, equal totals, dimension/free-coordinate bounds, dense margins; supplied finite word. Schedule: encoded margins and precision input."
      ],
      "limitations": [
        "No proved full encoded outer sampler or full machine-cost exponent."
      ],
