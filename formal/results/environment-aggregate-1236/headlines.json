    {
      "id": "finite-word-law",
      "title": "Finite-word probability law",
      "english_claim": "The typed both-branch sampler returns a feasible table for each reserved word and its uniform-word output law has total variation at most 2^-h.",
      "quantity": "Total variation ≤ 2⁻ʰ",
      "hypotheses": [
        "Equal-total natural margins, including zero margins and empty dimensions; uniform reserved bits."
      ],
      "limitations": [
        "The typed law uses noncomputable constructions; a complete encoded outer walker remains open."
      ],
      "evidence_class": "lean_theorem",
