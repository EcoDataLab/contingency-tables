    {
      "name": "Math115.CompletionSamplerSemantics.draw_semantics",
      "module": "Math115.CompletionSamplerSemantics",
      "kind": "theorem",
      "statement": "∀ {m n : ℕ} (d : ℕ) (hd : 14 ≤ d) (R : Fin (m + 1) → ℕ) (P : Fin (n + 1) → ℕ) (htotal : ∑ i, R i = ∑ j, P j),\n  m + 1 ≤ d →\n    n + 1 ≤ d →\n      m * n ≤ d - 1 →\n        (∀ (i : Fin (m + 1)), (n + 1) * (3 * d) ≤ R i) →\n          (∀ (j : Fin (n + 1)), (m + 1) * (3 * d) ≤ P j) →\n            ∀ (h : ℕ),\n              (∀ (bits : Fin (Math115.DenseLatticeCompletion.completionBits d R P h) → Bool),\n                  Math115.CompletionSamplerProgram.draw\n                      (Math115.CompletionSamplerSemantics.parameters d R P h, List.ofFn bits) =\n                    OAI.ContingencyTables.DensePrograms.matrixCode\n                      ↑(Math115.CompletionSamplerSemantics.programTable d hd R P htotal h bits)) ∧\n                OAI.ContingencyTables.FirstSuccess.variation\n                    (OAI.ContingencyTables.FirstSuccess.mapLaw OAI.ContingencyTables.FirstSuccess.uniformLaw\n                      (Math115.CompletionSamplerSemantics.programTable d hd R P htotal h))\n                    (Math115.LatticeCompletionAccuracy.originalUniform R P\n                      (OAI.ContingencyTables.GreedyFeasibleTable.table R P htotal)) ≤\n                  Math115.CompletionRetryBudget.dyadic h",
      "axioms": [
        "propext",
        "Classical.choice",
        "Quot.sound"
      ],
