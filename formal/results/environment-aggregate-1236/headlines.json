    {
      "name": "Math115.PhysicalBooleanSampler.draw_explicit_accuracy",
      "module": "Math115.PhysicalBooleanSampler",
      "kind": "theorem",
      "statement": "∀ {m n : ℕ} (r : Fin m → ℕ) (c : Fin n → ℕ) (htotal : ∑ i, r i = ∑ j, c j) (h : ℕ),\n  have p := Math115.CompletionOuterSchedule.physicalSmallCount r c;\n  have base := Math115.CompletionOuterSchedule.physicalMassBase r;\n  have T :=\n    Math115.CompletionOuterSchedule.walkCount p OAI.ContingencyTables.CompletionCounts.dimensionAllowance base h;\n  have R := Math115.CompletionOuterSchedule.restartCount p h;\n  have hStep :=\n    Math115.CompletionOuterSchedule.stepPrecision p OAI.ContingencyTables.CompletionCounts.dimensionAllowance base h;\n  have hTerminal := Math115.CompletionOuterSchedule.terminalPrecision p h;\n  ↑(OAI.ContingencyTables.FirstSuccess.variation\n        (OAI.ContingencyTables.FirstSuccess.mapLaw OAI.ContingencyTables.FirstSuccess.uniformLaw\n          (Math115.PhysicalBooleanSampler.draw r c htotal T R hStep hTerminal))\n        OAI.ContingencyTables.FirstSuccess.uniformLaw) ≤\n    ↑(Math115.CompletionRetryBudget.dyadic h)",
