    {
      "id": "ideal-inverse-gap",
      "title": "Ideal auxiliary chain",
      "english_claim": "The feasible ideal auxiliary chain satisfies variance at most 80000 d^17 times energy.",
      "quantity": "Inverse spectral gap ≤ 80,000d¹⁷",
      "hypotheses": [
        "Equal-total natural margins; finite index sets; d=10+(m+1)(n+1)."
      ],
      "limitations": [
        "Ideal completion transitions; a step count does not give machine runtime."
      ],
      "evidence_class": "lean_theorem",
