    "kind": "theorem",
    "module": "Research.JunctionStarBridge",
    "name": "Research.JunctionStarBridge.junction_energy_le_twelve_star",
    "nonstandard_axioms": [],
    "standard_axioms": [
      "propext",
      "Classical.choice",
      "Quot.sound"
    ],
    "statement": "\u2200 {B : Type u_1} {D : Type u_2} {J : Type u_3} [inst : Fintype B] [inst_1 : Fintype D] [inst_2 : Fintype J]\n  (rho : D \u2192 B) (w : D \u2192 \u211d) (S : B \u2192 D \u2192 \u211d) (src dst : J \u2192 B) (shared : J \u2192 D) (mu : J \u2192 \u211d),\n  (\u2200 (d : D), 0 \u2264 w d) \u2192\n    (\u2200 (b : B) (d : D), 0 \u2264 S b d) \u2192\n      (\u2200 (d : D), w d / 2 \u2264 S (rho d) d) \u2192\n        (\u2200 (j : J), 0 \u2264 mu j) \u2192\n          Function.Injective shared \u2192\n            (\u2200 (j : J), rho (shared j) = src j) \u2192\n              (\u2200 (j : J), mu j \u2264 w (shared j)) \u2192\n                (\u2200 (j : J), mu j / 2 \u2264 S (dst j) (shared j)) \u2192\n                  (\u2200 (b : B), (\u2211 j, if dst j = b then mu j else 0) \u2264 Research.JunctionStarBridge.repairMass rho w b) \u2192\n                    \u2200 (g : D \u2192 \u211d),\n                      Research.JunctionStarBridge.junctionEnergy src dst mu\n                          (Research.JunctionStarBridge.repairMean rho w g) \u2264\n                        12 * Research.JunctionStarBridge.starEnergy S g"
  },
