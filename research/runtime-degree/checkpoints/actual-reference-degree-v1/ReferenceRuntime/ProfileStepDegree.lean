      (typed_composition typed_second typed_second)) typed_completionDraw

lemma typed_referenceStepTranslation : Typed LatticeProfileStep.stepTranslationRealizer  := by
  unfold LatticeProfileStep.stepTranslationRealizer
  exact typed_pair (typed_pair typed_referenceStepOldMargins typed_referenceStepNewMargins) typed_referenceStepCompletion

/-- Original lattice-completion profile step. Both actual margin extractions,
full dense completion, translation check, neighbor proposal, rejected-word
current-view default and encoded output remain charged for every raw input. -/
theorem typed_actual_profileStep : Typed LatticeProfileStep.profileStepRealizer  := by
  unfold LatticeProfileStep.profileStepRealizer
  exact typed_congr _ (typed_choose
    (typed_composition typed_referenceStepTranslation Math115.ReferenceMetadata.typed_translationValid)
    Math115.UnitRuntimeNext.typed_stepCandidateViews Math115.UnitRuntimeNext.typed_stepViews)

/-- The original cap-guarded profile fold, including arbitrary metadata and
supplied words; its existing cubic intermediate envelope is retained. -/
theorem typed_actual_profileWalk : Typed LatticeProfileWalk.profileWalkRealizer  :=
  Math115.DrawDegree.typed_profileWalk typed_actual_profileStep (by decide)

#check typed_actual_profileStep
