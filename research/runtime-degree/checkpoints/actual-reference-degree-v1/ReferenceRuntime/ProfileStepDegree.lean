lemma typed_referenceStepCandidate : Typed stepCandidateRealizer 14119810930125884322720 := by
  unfold stepCandidateRealizer
  exact typed_composition
    (typed_pair Math115.UnitRuntimeNext.typed_stepCheck Math115.UnitRuntimeNext.typed_stepCandidateViews)
    Math115.UnitRuntimeNext.typed_candidateData

lemma typed_referenceStepCandidateParameters : Typed stepCandidateParametersRealizer 14119810930125884322720 := by
  unfold stepCandidateParametersRealizer
  exact typed_pair
    (typed_pair typed_referenceStepCandidate (typed_composition (typed_composition typed_first typed_first) typed_second))
    (typed_composition typed_first typed_second)

lemma typed_referenceStepOldMargins : Typed stepOldMarginsRealizer 211958712 := by
  unfold stepOldMarginsRealizer
  exact typed_composition (typed_composition typed_first Math115.ReferenceMetadata.typed_residualParameters) typed_first

lemma typed_referenceStepNewMargins : Typed stepNewMarginsRealizer 2992816938433004438904723536640 := by
